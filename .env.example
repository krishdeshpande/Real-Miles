# ==============================================================================
# Real Miles Environment Configuration Template
# All secrets and environment variables required for running Real Miles.
# Fill in your values and copy to .env.local. Do not commit actual credentials.
# ==============================================================================

# Application Branding
# Name displayed across UI and metadata
NEXT_PUBLIC_APP_NAME=

# Data Mode
# Choose 'supabase' for production/cloud database, or 'local' for local development file storage
# Note: App refuses to run with DATA_MODE=local in production (NODE_ENV=production)
DATA_MODE=

# Supabase Configuration
# Required when DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM Provider Configuration
# Set LLM_MODE=mock for offline development without real API keys
# Set LLM_MODE=real to use live Gemini API (refuses to fall back silently)
LLM_MODE=
GEMINI_API_KEY=
LLM_MODEL=

# Speech-to-Text (Whisper) Provider Configuration
# Set STT_MODE=mock for offline development without real API keys
# Set STT_MODE=real to use live Groq Whisper API (refuses to fall back silently)
STT_MODE=
GROQ_API_KEY=
STT_MODEL=

# Vector Embeddings Configuration
EMBED_MODEL=

# Security & Access Control
# Comma-separated emails granted administrative privileges
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=

# Development Auth Controls
# Set to 'true' to show quick mock login selector in development only (NODE_ENV=development)
NEXT_PUBLIC_DEMO_LOGIN=

# Data Display Flags
# Set to 'true' to render demo seed markers
SHOW_DEMO=
